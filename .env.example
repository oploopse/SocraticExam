# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mật khẩu truy cập ứng dụng. Để trống khi chạy local; đặt trước khi triển khai hoặc chia sẻ link.
APP_ACCESS_TOKEN=

# Model. Đổi sang model khác nếu free tier của model đang dùng bị giới hạn.
BRAIN_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Kore

# Thời gian im lặng (ms) trước khi AI được nói. Giảm để AI đáp nhanh hơn; tăng nếu AI hay cướp lời.
VAD_SILENCE_MS=1000
# Thời gian xác nhận bắt đầu nói (ms). Giảm để bắt câu ngắn; tăng nếu tạp âm làm AI dừng nói.
VAD_PREFIX_PADDING_MS=100
# high: bắt câu ngắn nhạy hơn. low: dùng khi phòng ồn để tạp âm không làm AI dừng nói.
VAD_START_SENSITIVITY=high
# Token suy nghĩ của Gemini Live trước mỗi lượt nói. 0 = đáp nhanh nhất, -1 = model tự quyết.
LIVE_THINKING_BUDGET=0
# Ngôn ngữ chính khi nhận dạng và khi AI nói, cùng ngôn ngữ của thuật ngữ người học hay chêm vào.
SPEECH_LANGUAGE=vi-VN
TERM_LANGUAGES=en-US

# Một lần gọi Gemini quá số giây này thì chuyển sang model dự phòng.
LLM_TIMEOUT_S=30
KNOWLEDGE_TIMEOUT_S=240

# Giới hạn của một buổi phỏng vấn
INTERVIEW_MINUTES=15
MAX_CONCEPTS_PER_SESSION=6
MAX_ANSWERS_PER_CONCEPT=4
MAX_HINTS_PER_CONCEPT=1

# Số lượt tối đa mỗi giờ cho một IP, để link demo không làm cạn quota Gemini. 0 = không giới hạn.
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_SESSIONS_PER_HOUR=20
RATE_LIMIT_MESSAGES_PER_HOUR=300

# Cầu nối Vercel /api/hello tới API ngrok (app kiểm tra kết nối có sẵn trên repo).
API_BASE_URL=https://debatable-awning-unbridle.ngrok-free.dev
